# Copy this file to .env and fill in real values before running in production.

PORT=4000

# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Access token lifetime
JWT_EXPIRES_IN=8h

# Public base URL used inside generated QR codes (no sensitive data is ever
# embedded in the QR itself -- only an opaque scan URL + token id).
PUBLIC_BASE_URL=http://localhost:4000

# Minutes a standard QR scan token stays valid before it must be re-issued
QR_TOKEN_TTL_MINUTES=15

# Minutes an emergency-access token stays valid (kept short on purpose)
EMERGENCY_TOKEN_TTL_MINUTES=60

# SQLite file path
DB_PATH=./data/passport.db
